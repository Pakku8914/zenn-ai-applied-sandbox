{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],

    // import/export を持たないファイルもモジュールとして扱う。
    // これが無いと全ファイルがグローバルスコープを共有し、
    // セッションごとの verify.ts で同名変数が衝突する。
    "moduleDetection": "force",

    // 型安全性の設定（本書はこの2つを必ず有効にする）
    "strict": true,
    "noUncheckedIndexedAccess": true,

    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    // tsx で直接実行するため JavaScript は出力しない
    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"]
}
