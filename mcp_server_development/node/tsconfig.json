{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],

    // Node.js の ESM 解決規則に合わせる。
    // これにより相対 import に `.js` 拡張子が必須になり、
    // 書き忘れを `npm run typecheck` が検出できる（実行時エラーを事前に潰せる）
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src"]
}
