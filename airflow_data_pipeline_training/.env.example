# ============================================================================
# 実験室の設定を上書きしたいときだけ、このファイルを .env にコピーして編集する
# ----------------------------------------------------------------------------
# 何も設定しなくても compose.yaml の既定値で動きます（.env は必須ではありません）。
# ============================================================================

# Web UI のログインユーザー（既定: airflow / airflow）
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow

# Connection / Variable を暗号化する鍵。実運用では必ず自分で生成し直す。
#   生成例: docker run --rm apache/airflow:3.2.1-python3.12 \
#             python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Airflow 内部 API の署名に使う秘密。実運用では必ず自分で生成し直す。
AIRFLOW_JWT_SECRET=

# Linux で bind mount の所有者がずれる場合に、自分のユーザーIDを指定する。
#   確認方法: id -u
# Windows / Mac では通常は設定不要（既定の 50000 でよい）。
AIRFLOW_UID=50000
