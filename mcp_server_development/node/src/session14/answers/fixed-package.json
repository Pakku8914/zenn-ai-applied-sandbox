{
  "name": "attendance-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "社内の勤怠データを読み取る読み取り専用の MCP サーバー（stdio）",
  "keywords": ["mcp", "modelcontextprotocol", "mcp-server", "attendance"],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
