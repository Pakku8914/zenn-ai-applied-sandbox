# このファイルを .env にコピーすると compose.yaml の既定値を上書きできる。.env は Git に入れない。
# 既定（何も書かない）では、LLM はすべて mockllm に向き、課金は発生しない。

# --- 実際の Claude API で確かめる任意課題（課金あり）のときだけ ---
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_API_KEY=ここに自分のキー（Git に入れない・本文に貼らない）
# LLM_MODEL=claude-sonnet-5-5
# LLM_MODEL_LIGHT=claude-haiku-4-5

# --- OpenAI 互換に差し替える実演を実 API で行うときだけ ---
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=

# --- api コンテナで起動するアプリを切り替える（例：セッション5のアプリ） ---
# APP_MODULE=src.session05.app:app
